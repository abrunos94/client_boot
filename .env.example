# ============================================================================
# clientflow-bot & clientflow-ai — Variáveis de Ambiente (EXEMPLO)
# NUNCA faça commit de chaves reais, tokens da Meta ou service_role no Git.
# ============================================================================

NODE_ENV=development
PORT=3000

# Meta WhatsApp Business Platform (Aplicação Central do ClientFlow)
META_APP_SECRET=change_me_meta_app_secret_for_hmac_sha256
META_WEBHOOK_VERIFY_TOKEN=change_me_webhook_verify_token
META_GRAPH_API_VERSION=v21.0
META_DRY_RUN=true
META_PHONE_NUMBER_ID_ORG_ALPHA=phone_id_org_alpha_101
META_WABA_ID_ORG_ALPHA=waba_alpha_9001

# Provedor Inicial de IA (clientflow-ai -> Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Projeto Supabase Individual por Empresa (Alternativa A)
SUPABASE_URL_ORG_ALPHA=https://seu-projeto-alpha.supabase.co
SUPABASE_SERVICE_KEY_ORG_ALPHA=
SUPABASE_URL_ORG_BETA=https://seu-projeto-beta.supabase.co
SUPABASE_SERVICE_KEY_ORG_BETA=

# Segredos Simulados por Referência (Em produção, usar Secret Manager / KMS)
# Nenhuma empresa compartilha token ou banco operacional com outra.
SECRET_WABA_TOKEN_ORG_ALPHA=simulated_meta_token_org_alpha_only
SECRET_WABA_TOKEN_ORG_BETA=simulated_meta_token_org_beta_only
SECRET_DB_URL_ORG_ALPHA=postgres://tenant_alpha_user:secret@localhost:5432/clientflow_org_alpha
SECRET_DB_URL_ORG_BETA=postgres://tenant_beta_user:secret@localhost:5432/clientflow_org_beta

